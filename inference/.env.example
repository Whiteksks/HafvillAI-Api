# Paths resolve from the repository or exported bundle root.
HAFVILLAI_ARTIFACTS_DIR=inference/artifacts
HAFVILLAI_HOST=127.0.0.1
HAFVILLAI_PORT=8000
HAFVILLAI_ENABLE_SUBCONSCIOUSNESS=1
HAFVILLAI_MAX_INPUT_TOKENS=1536
HAFVILLAI_MAX_NEW_TOKENS=512
HAFVILLAI_MAX_QUEUE_SIZE=4
HAFVILLAI_MAX_BODY_BYTES=1048576
# Required by Docker Compose and for non-loopback listeners. Keep this private.
HAFVILLAI_API_KEY=
HAFVILLAI_CONSCIOUSNESS_REPETITION_PENALTY=1.0
HAFVILLAI_SUBCONSCIOUSNESS_REPETITION_PENALTY=1.2
# Optional HTTPS profile: set a real domain pointing to the Brev instance.
HAFVILLAI_DOMAIN=localhost
