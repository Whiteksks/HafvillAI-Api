# Only inference code, the shared runtime, and vendored Mamba enter the build.
**
!inference/
!inference/**
!hafvillai_runtime/
!hafvillai_runtime/**
!mamba-source/
!mamba-source/**
inference/artifacts/
inference/dist/
inference/tests/
inference/.env
inference/.env.*
!inference/.env.example
**/.cache/
**/.venv/
**/__pycache__/
**/.env
**/.env.*
!inference/.env.example
**/secrets/
**/.aws/
**/.ssh/
**/.codex/
**/.agents/
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.pyc
**/*.egg-info/
**/build/
mamba-source/.github/
mamba-source/tests/
mamba-source/benchmarks/
mamba-source/evals/
